# Copy to .env and fill in. .env is gitignored.

# Google Gemini (free tier: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# HuggingFace (https://huggingface.co/settings/tokens) — needed to download
# meta-llama/Llama-3.1-8B-Instruct. Alternative: use
# NousResearch/Meta-Llama-3.1-8B-Instruct which is ungated.
HF_TOKEN=
